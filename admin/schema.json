{
  "type": "panel",
  "title": {
    "de": "Tankmonitor Konfiguration",
    "en": "Tankmonitor Configuration"
  },
  "fields": [
    {
      "label": {
        "de": "Oilview Einstellungen",
        "en": "Oilview Settings"
      },
      "type": "group",
      "fields": [
        {"label": {"de": "Aktiviert", "en": "Enabled"}, "type": "checkbox", "id": "oilview.enabled"},
        {"label": {"de": "Benutzername", "en": "Username"}, "type": "text", "id": "oilview.username"},
        {"label": {"de": "Passwort", "en": "Password"}, "type": "password", "id": "oilview.password"},
        {"label": {"de": "Abrufintervall (Minuten)", "en": "Polling Interval (Minutes)"}, "type": "number", "id": "oilview.interval", "min": 5, "default": 15}
      ]
    },
    {
      "label": {"de": "Tankinhaltsanzeige Einstellungen", "en": "Tankinhaltsanzeige Settings"},
      "type": "group",
      "fields": [
        {"label": {"de": "Aktiviert", "en": "Enabled"}, "type": "checkbox", "id": "tankinhaltsanzeige.enabled"},
        {"label": {"de": "Benutzername", "en": "Username"}, "type": "text", "id": "tankinhaltsanzeige.username"},
        {"label": {"de": "Passwort", "en": "Password"}, "type": "password", "id": "tankinhaltsanzeige.password"},
        {"label": {"de": "Abrufintervall (Minuten)", "en": "Polling Interval (Minutes)"}, "type": "number", "id": "tankinhaltsanzeige.interval", "min": 5, "default": 30}
      ]
    },
    {
      "label": {"de": "LiquidCheck Einstellungen", "en": "LiquidCheck Settings"},
      "type": "group",
      "fields": [
        {"label": {"de": "Aktiviert", "en": "Enabled"}, "type": "checkbox", "id": "liquidCheck.enabled"},
        {"label": {"de": "Grafana URL", "en": "Grafana URL"}, "type": "url", "id": "liquidCheck.url", "default": "https://liquidcheck.si-elektronik.de"},
        {"label": {"de": "Benutzername", "en": "Username"}, "type": "text", "id": "liquidCheck.username"},
        {"label": {"de": "Passwort", "en": "Password"}, "type": "password", "id": "liquidCheck.password"},
        {"label": {"de": "Abrufintervall (Minuten)", "en": "Polling Interval (Minutes)"}, "type": "number", "id": "liquidCheck.interval", "min": 5, "default": 5}
      ]
    }
  ]
}