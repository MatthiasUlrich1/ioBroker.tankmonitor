{
    "i18n": false,
    "type": "panel",
    "items": {
        "oilview": {
            "type": "panel",
            "label": "Oilview Settings",
            "items": {
                "oilviewEnabled": {
                    "type": "checkbox",
                    "label": "Enable Oilview",
                    "default": false,
                    "xs": 12,
                    "sm": 6
                },
                "oilviewUrl": {
                    "type": "text",
                    "label": "URL",
                    "default": "https://www.oilview.de",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.oilviewEnabled"
                },
                "oilviewUsername": {
                    "type": "text",
                    "label": "Username / E-Mail",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.oilviewEnabled"
                },
                "oilviewPassword": {
                    "type": "password",
                    "label": "Password",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.oilviewEnabled"
                },
                "oilviewInterval": {
                    "type": "number",
                    "label": "Interval (Minutes)",
                    "min": 5,
                    "default": 15,
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.oilviewEnabled"
                }
            }
        },
        "tankinhaltsanzeige": {
            "type": "panel",
            "label": "Tankinhaltsanzeige Settings",
            "items": {
                "tankEnabled": {
                    "type": "checkbox",
                    "label": "Enable Tankinhaltsanzeige",
                    "default": false,
                    "xs": 12,
                    "sm": 6
                },
                "tankUrl": {
                    "type": "text",
                    "label": "URL",
                    "default": "https://www.tankinhaltsanzeige.de",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.tankEnabled"
                },
                "tankUsername": {
                    "type": "text",
                    "label": "Username / E-Mail",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.tankEnabled"
                },
                "tankPassword": {
                    "type": "password",
                    "label": "Password",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.tankEnabled"
                },
                "tankInterval": {
                    "type": "number",
                    "label": "Interval (Minutes)",
                    "min": 5,
                    "default": 30,
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.tankEnabled"
                }
            }
        },
        "liquidCheck": {
            "type": "panel",
            "label": "LiquidCheck (Grafana) Settings",
            "items": {
                "liquidCheckEnabled": {
                    "type": "checkbox",
                    "label": "Enable LiquidCheck",
                    "default": false,
                    "xs": 12,
                    "sm": 6
                },
                "liquidCheckUrl": {
                    "type": "text",
                    "label": "Grafana URL",
                    "default": "https://liquidcheck.si-elektronik.de",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.liquidCheckEnabled"
                },
                "liquidCheckUsername": {
                    "type": "text",
                    "label": "Username / E-Mail",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.liquidCheckEnabled"
                },
                "liquidCheckPassword": {
                    "type": "password",
                    "label": "Password",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.liquidCheckEnabled"
                },
                "liquidCheckInterval": {
                    "type": "number",
                    "label": "Interval (Minutes)",
                    "min": 5,
                    "default": 5,
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.liquidCheckEnabled"
                }
            }
        }
    }
}
