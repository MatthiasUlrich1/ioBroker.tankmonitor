{
    "i18n": false,
    "type": "panel",
    "items": {
        "oilview": {
            "type": "panel",
            "label": "Oilview Settings",
            "items": {
                "enabled": {
                    "type": "checkbox",
                    "label": "Enable Oilview",
                    "xs": 12,
                    "sm": 6
                },
                "url": {
                    "type": "text",
                    "label": "URL",
                    "default": "https://www.oilview.de",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.oilview.enabled"
                },
                "username": {
                    "type": "text",
                    "label": "Username / E-Mail",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.oilview.enabled"
                },
                "password": {
                    "type": "password",
                    "label": "Password",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.oilview.enabled"
                },
                "interval": {
                    "type": "number",
                    "label": "Interval (Minutes)",
                    "min": 5,
                    "default": 15,
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.oilview.enabled"
                }
            }
        },
        "tankinhaltsanzeige": {
            "type": "panel",
            "label": "Tankinhaltsanzeige Settings",
            "items": {
                "enabled": {
                    "type": "checkbox",
                    "label": "Enable Tankinhaltsanzeige",
                    "xs": 12,
                    "sm": 6
                },
                "url": {
                    "type": "text",
                    "label": "URL",
                    "default": "https://www.tankinhaltsanzeige.de",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.tankinhaltsanzeige.enabled"
                },
                "username": {
                    "type": "text",
                    "label": "Username / E-Mail",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.tankinhaltsanzeige.enabled"
                },
                "password": {
                    "type": "password",
                    "label": "Password",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.tankinhaltsanzeige.enabled"
                },
                "interval": {
                    "type": "number",
                    "label": "Interval (Minutes)",
                    "min": 5,
                    "default": 30,
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.tankinhaltsanzeige.enabled"
                }
            }
        },
        "liquidCheck": {
            "type": "panel",
            "label": "LiquidCheck (Grafana) Settings",
            "items": {
                "enabled": {
                    "type": "checkbox",
                    "label": "Enable LiquidCheck",
                    "xs": 12,
                    "sm": 6
                },
                "url": {
                    "type": "text",
                    "label": "Grafana URL",
                    "default": "https://liquidcheck.si-elektronik.de",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.liquidCheck.enabled"
                },
                "username": {
                    "type": "text",
                    "label": "Username / E-Mail",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.liquidCheck.enabled"
                },
                "password": {
                    "type": "password",
                    "label": "Password",
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.liquidCheck.enabled"
                },
                "interval": {
                    "type": "number",
                    "label": "Interval (Minutes)",
                    "min": 5,
                    "default": 5,
                    "xs": 12,
                    "sm": 6,
                    "hidden": "!data.liquidCheck.enabled"
                }
            }
        }
    }
}
